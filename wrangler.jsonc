{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aolchatroom",
  "main": "src/index_v39_coherence.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws*", "/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "MISTRAL_MODEL": "mistral-small-latest",
    "VERCEL_AI_MODEL": "openai/gpt-oss-20b",
    "OPENROUTER_MODEL": "openrouter/free",
    "HF_MODEL": "openai/gpt-oss-120b:cheapest",
    "CEREBRAS_MODEL": "gpt-oss-120b",
    "COHERE_MODEL": "command-r7b-12-2024",
    "ALLOW_DEV_TRIAL_PROVIDERS": "0",
    "SIMULATED_DATE": "November 22, 1996",
    "DEPLOY_VERSION": "39"
  }
}
