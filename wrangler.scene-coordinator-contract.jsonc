{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aolchatroom-scene-coordinator-contract",
  "main": "test/runtime_scene_coordinator_worker.js",
  "compatibility_date": "2026-08-19",
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTRACT_ROOMS",
        "class_name": "RuntimeSceneCoordinatorRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RuntimeSceneCoordinatorRoom"]
    }
  ],
  "vars": {
    "GEMINI_API_KEY": "runtime-contract-gemini",
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "DEPLOY_VERSION": "41"
  }
}
