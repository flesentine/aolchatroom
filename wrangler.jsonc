{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aolchatroom",
  "main": "src/index_v11.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws*", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      }
    ]
  },
  "exports": {
    "ChatRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "GROQ_MODEL": "openai/gpt-oss-20b",
    "SIMULATED_DATE": "November 22, 1996"
  }
}
